{
  "name": "printifyx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -c \"blue,green\" \"npx @tailwindcss/cli -i ./src/styles.css -o ./public/output.css --watch\" \"vite\"",
    "build:css": "npx @tailwindcss/cli -i ./src/styles.css -o ./public/output.css",
    "build": "npm run build:css && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.17",
    "@tailwindcss/postcss": "^4.1.17",
    "@tailwindcss/vite": "^4.1.17",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.1.7"
  }
}
